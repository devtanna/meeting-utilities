// Single rename point for product identity. Copy to Identity.xcconfig (git-ignored) and edit.
MU_PRODUCT_NAME = MeetingUtility
MU_BUNDLE_ID = com.devtanna.meetingutils
// Sparkle appcast (placeholder until a release domain exists) and EdDSA public key from Sparkle's generate_keys.
MU_SPARKLE_FEED_URL = https:/$()/updates.example.invalid/meetingutility/appcast.xml
MU_SPARKLE_PUBLIC_KEY =

// Optional stable signing identity (keeps privacy permissions across rebuilds):
// MU_TEAM_ID = ABCDE12345
// CODE_SIGN_IDENTITY = Apple Development
// ENABLE_HARDENED_RUNTIME = YES
